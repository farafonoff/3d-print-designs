.DS_Store

# Sliced output: printer/filament specific, easy to regenerate
*.gcode
*.gcode.3mf

# Editor / tool state
.claude/

# Bookmark meshes come from per-pixel height maps and are huge (200+ MB); regenerate with ./previews.sh --stl
bookmarks/*.stl

# Slicer project files (printer/filament specific)
*.3mf

# Door cable guide meshes are huge (15-50 MB, per-segment bends); regenerate with ./previews.sh --stl
doorcable/*.stl
